---
import Base from '../layouts/Base.astro';
import MatchList from '../components/MatchList.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { fetchMatches, getMatchesForSport } from '../lib/data';
import { hubFaqSchema } from '../lib/seo';
import { hubFaqText } from '../lib/faq';

const matches = await fetchMatches();
const sportMatches = getMatchesForSport(matches, 'nhl');

const title = `NHL En Vivo Gratis Hoy - Roja Directa Hockey | 1RojaDirecta`;
const description = `Ver NHL en vivo gratis. ${sportMatches.length} partidos de hockey disponibles hoy. Sin registro.`;
const faqItems = hubFaqText('NHL', sportMatches);
---
<Base title={title} description={description} schema={[hubFaqSchema('NHL', sportMatches)]}>
  <div class="container section">
    <h1>NHL En Vivo Hoy <span style="color:var(--text-muted);font-weight:400;font-size:0.7em;">({sportMatches.length} partidos)</span></h1>
    <p class="seo-text">Ver hockey NHL en vivo gratis. Panthers, Rangers, Oilers, Maple Leafs y más equipos en directo. Sin registro.</p>
    {sportMatches.length > 0 ? <MatchList matches={sportMatches} /> : <p class="text-muted text-center" style="padding:3rem 0;">No hay partidos NHL disponibles ahora.</p>}
    <FaqBlock items={faqItems} />
  </div>
</Base>
