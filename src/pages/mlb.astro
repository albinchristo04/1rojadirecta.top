---
import Base from '../layouts/Base.astro';
import MatchList from '../components/MatchList.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { fetchMatches, getMatchesForSport } from '../lib/data';
import { hubFaqSchema, itemListSchema } from '../lib/seo';
import { hubFaqText } from '../lib/faq';

const matches = await fetchMatches();
const mlbMatches = getMatchesForSport(matches, 'mlb');
const baseball = [...mlbMatches, ...getMatchesForSport(matches, 'beisbol')];
const all = [...new Map(baseball.map(m => [m.slug, m])).values()];

const title = `MLB En Vivo - Béisbol en Directo Gratis · Roja Directa MLB | 1RojaDirecta`;
const description = `Ver MLB en vivo gratis. Béisbol en directo sin registro. ${all.length} partidos disponibles hoy. Roja Directa MLB · Tarjeta Roja MLB · Pirlo TV MLB.`;
const schema = [hubFaqSchema('MLB', all), itemListSchema(all, 'Partidos MLB en Vivo')];
const faqItems = hubFaqText('MLB', all);
---
<Base title={title} description={description} schema={schema}>
  <div class="container section">
    <div style="margin-bottom:1.5rem;">
      <span class="badge badge--sport">MLB · Béisbol</span>
      <h1 style="margin-top:0.5rem;">MLB En Vivo <span style="color:var(--text-muted);font-weight:400;font-size:0.7em;">({all.length} partidos)</span></h1>
      <p class="seo-text" style="margin-top:0.5rem;">
        Ver MLB en vivo gratis hoy. Major League Baseball en directo — Yankees, Dodgers, Astros, Red Sox y más.
        Roja Directa MLB · Tarjeta Roja MLB · Pirlo TV MLB. Sin registro, sin cable.
      </p>
    </div>
    {all.length > 0
      ? <MatchList matches={all} />
      : <p class="text-muted text-center" style="padding:3rem 0;">No hay partidos de MLB ahora. Temporada: consulta el calendario.</p>
    }
    <FaqBlock items={faqItems} />
  </div>
</Base>
