---
import Base from '../layouts/Base.astro';
import MatchList from '../components/MatchList.astro';
import { fetchMatches } from '../lib/data';
import { homeTitle, homeMeta, itemListSchema, jsonLd } from '../lib/seo';
import { COMPETITION_HUBS } from '../lib/config';

const matches = await fetchMatches();
const today = new Date().toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const todayCapitalized = today.charAt(0).toUpperCase() + today.slice(1);

const title = homeTitle();
const description = homeMeta();
const schema = [itemListSchema(matches, 'Partidos en Vivo Hoy')];

const buildTime = new Date().toISOString();
---
<Base title={title} description={description} schema={schema}>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__tag">
        EN VIVO · {matches.length} Partidos
      </div>
      <h1 class="hero__title">Partidos en Vivo Hoy — {todayCapitalized}</h1>
      <p class="hero__subtitle">
        Ver deportes en vivo gratis. Sin registro, sin pago. Múltiples canales disponibles.
      </p>
      <div class="hero__brands">
        <a href="/tarjeta-roja/" class="brand-pill" id="hero-tarjeta-roja">Tarjeta Roja TV</a>
        <a href="/pirlo-tv/" class="brand-pill" id="hero-pirlo-tv">Pirlo TV</a>
        <a href="/roja-directa-pirlo-tv/" class="brand-pill" id="hero-roja-pirlo">Roja Directa Pirlo TV</a>
      </div>
      <p class="hero__meta">Actualizado: {buildTime.replace('T', ' ').slice(0, 16)} UTC · Recarga automática cada 3h</p>
    </div>
  </section>

  <div class="container section" style="padding-top:1.25rem; padding-bottom:0.5rem;">
    <div style="margin-bottom:1rem;">
      <span class="badge badge--sport">Ligas en Español</span>
      <h2 style="margin-top:0.5rem;">Competiciones Prioritarias Para Latinoamérica</h2>
      <p class="seo-text" style="margin-top:0.5rem;">
        Accesos directos a páginas creadas en español para búsquedas de Bing sobre Liga MX, Libertadores, Sudamericana, fútbol argentino, colombiano, peruano, ecuatoriano y más.
      </p>
      <div class="hero__brands" style="justify-content:flex-start; margin-top:0.85rem;">
        {COMPETITION_HUBS.map(hub => (
          <a href={`/${hub.slug}/`} class="brand-pill" id={`home-hub-${hub.slug}`}>{hub.label}</a>
        ))}
      </div>
    </div>
  </div>

  <!-- Match Listings -->
  <div class="container section">
    {matches.length === 0 ? (
      <div class="text-center" style="padding: 4rem 0; color: var(--text-muted);">
        <p style="font-size:1.5rem; margin-bottom:0.5rem;">📡</p>
        <p>No hay partidos disponibles en este momento. Vuelve pronto.</p>
      </div>
    ) : (
      <MatchList matches={matches} />
    )}
  </div>

  <!-- SEO Text Block -->
  <div class="container">
    <p class="seo-text">
      Bienvenido a <strong>1RojaDirecta</strong> — tu destino para ver deportes en vivo gratis.
      Somos el hogar de <strong>Roja Directa</strong>, <strong>Tarjeta Roja TV</strong> y <strong>Pirlo TV</strong> en un solo lugar.
      Hoy hay <strong>{matches.length} partidos disponibles</strong> en directo: fútbol, béisbol MLB, baloncesto NBA, hockey NHL y más.
      Sin registro, sin cable, sin pago. Disponible en español, inglés, francés, italiano y portugués.
      Actualizado automáticamente cada 3 horas. También conocido como <em>Roja Dirécta</em>, <em>1 Roja Directa</em>.
    </p>
  </div>
</Base>
