---
// /ver/[slug]/ — canonical redirect to /partido/[slug]/
// Targets "ver X en vivo gratis" search cluster
import { fetchMatches } from '../../lib/data';
import { SITE_URL } from '../../lib/config';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const { fetchMatches: fm } = await import('../../lib/data');
  const matches = await fm();
  return matches.map(m => ({
    params: { slug: m.slug },
    props: { match: m },
  }));
}

const { match } = Astro.props;
const canonical = `${SITE_URL}/partido/${match.slug}/`;
---
<Base
  title={`Ver ${match.team1} vs ${match.team2} en Vivo Gratis — ${match.leagueLabel} | 1RojaDirecta`}
  description={`Ver ${match.team1} vs ${match.team2} en vivo gratis. ${match.leagueLabel} — ${match.time} UTC. ${match.channels.length} canales disponibles.`}
  canonical={canonical}
>
  <div class="container section" style="text-align:center; padding: 4rem 1rem;">
    <p style="font-size:1.5rem; margin-bottom:0.75rem;">📡</p>
    <h1 style="font-size:1.2rem;">Ver {match.team1} vs {match.team2} en Vivo</h1>
    <p style="color:var(--text-secondary); margin: 0.5rem 0 1.5rem;">
      Redirigiendo al reproductor...
    </p>
    <a href={`/partido/${match.slug}/`} class="match-card__cta" style="display:inline-flex;" id={`ver-redirect-${match.slug}`}>
      ▶ Ver Partido Ahora
    </a>
  </div>
</Base>

<script define:vars={{ dest: `/partido/${match.slug}/` }}>
  // Immediate JS redirect for users; canonical tells Google where the real page is
  if (typeof window !== 'undefined') {
    window.location.replace(dest);
  }
</script>
