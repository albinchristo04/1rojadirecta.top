---
import Base from '../layouts/Base.astro';
import MatchList from '../components/MatchList.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { fetchMatches, getMatchesForSport } from '../lib/data';
import { hubFaqSchema } from '../lib/seo';
import { hubFaqText } from '../lib/faq';

const matches = await fetchMatches();
const sportMatches = getMatchesForSport(matches, 'motogp');

const title = `MotoGP En Vivo Gratis - Roja Directa MotoGP | 1RojaDirecta`;
const description = `Ver MotoGP en vivo gratis. ${sportMatches.length} carreras disponibles. Sin registro, sin cable.`;
const faqItems = hubFaqText('MotoGP', sportMatches);
---
<Base title={title} description={description} schema={[hubFaqSchema('MotoGP', sportMatches)]}>
  <div class="container section">
    <h1>MotoGP En Vivo <span style="color:var(--text-muted);font-weight:400;font-size:0.7em;">({sportMatches.length} carreras)</span></h1>
    <p class="seo-text">Ver MotoGP en vivo gratis. Carreras de Moto GP en directo con múltiples canales. Sin registro.</p>
    {sportMatches.length > 0 ? <MatchList matches={sportMatches} /> : <p class="text-muted text-center" style="padding:3rem 0;">No hay carreras MotoGP disponibles ahora.</p>}
    <FaqBlock items={faqItems} />
  </div>
</Base>
