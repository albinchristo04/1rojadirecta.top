---
import Base from '../layouts/Base.astro';
import MatchList from '../components/MatchList.astro';
import FaqBlock from '../components/FaqBlock.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { hubFaqSchema, itemListSchema, breadcrumbSchema } from '../lib/seo';
import { hubFaqText } from '../lib/faq';
import { COMPETITION_HUBS, SITE_URL } from '../lib/config';

export async function getStaticPaths() {
  const { fetchMatches: fm } = await import('../lib/data');
  const matches = await fm();

  return COMPETITION_HUBS.map(competition => ({
    params: { league: competition.slug },
    props: {
      competition,
      matches,
    },
  }));
}

const { competition, matches } = Astro.props;

const title = competition.title;
const description = competition.description;
const canonical = `${SITE_URL}/${competition.slug}/`;

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Fútbol', href: '/futbol/' },
  { name: competition.label, href: canonical },
];

const schema = [
  hubFaqSchema(competition.label, matches),
  itemListSchema(matches, `Partidos de ${competition.label} en Vivo`),
  breadcrumbSchema(breadcrumbs),
];

const faqItems = hubFaqText(competition.label, matches);
const relatedHubs = COMPETITION_HUBS.filter(hub => hub.slug !== competition.slug);
---
<Base title={title} description={description} canonical={canonical} schema={schema} keywords={competition.keywords.join(', ')}>
  <div class="container section">
    <Breadcrumb items={breadcrumbs} />

    <div style="margin-bottom:1.5rem; padding-top:0.5rem;">
      <span class="badge badge--sport">Fútbol</span>
      <h1 style="margin-top:0.5rem;">{competition.label} En Vivo <span style="color:var(--text-muted);font-weight:400;font-size:0.7em;">({matches.length} partidos)</span></h1>
      <p class="seo-text" style="margin-top:0.5rem;">
        {competition.intro}
      </p>
      <p class="seo-text" style="margin-top:0.75rem;">
        Esta página muestra todos los partidos disponibles del sitio en un solo listado, pensada para usuarios que buscan {competition.label} en vivo, horarios, canales y dónde ver hoy desde un sitio en español.
      </p>
      <div class="hero__brands" style="justify-content:flex-start; margin-top:1rem;">
        {competition.keywords.map((keyword, index) => (
          <span class="brand-pill" id={`keyword-${competition.slug}-${index}`}>{keyword}</span>
        ))}
      </div>
    </div>

    {matches.length > 0
      ? <MatchList matches={matches} groupByLeague={false} />
      : <p class="text-muted text-center" style="padding:3rem 0;">No hay partidos disponibles ahora.</p>
    }

    <div style="margin-top:2rem;">
      <h2>Otras Ligas Destacadas</h2>
      <p class="seo-text" style="margin-top:0.5rem;">
        Más hubs en español orientados a búsquedas de fútbol latinoamericano y torneos regionales.
      </p>
      <div class="hero__brands" style="justify-content:flex-start; margin-top:0.75rem;">
        {relatedHubs.map(hub => (
          <a href={`/${hub.slug}/`} class="brand-pill" id={`hub-link-${hub.slug}`}>{hub.label}</a>
        ))}
      </div>
    </div>

    <FaqBlock items={faqItems} />
  </div>
</Base>
